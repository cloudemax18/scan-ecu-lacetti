+package com.cheviexplorer.android
+
+import java.io.ByteArrayOutputStream
+
+/**
+ * Definiciones dinámicas del servicio KWP 0x2C que el ejecutable Delphi original (CheviExplorer1.8.exe)
+ * envía justo después de StartCommunication y antes de pedir `21 F0` / `21 F1`.
+ *
+ * Evidencia (análisis estático, NO probado en vehículo ni con este APK):
+ *  - main.pas TForm1.Start: MR-140 -> llamadas WriteReadComm en 0x4E4EF6 (F0) y 0x4E53FC (F1);
+ *    ZF 4HP16 -> 0x4E5ACA (F0). Las tres leen hasta 255 bytes (read count 0xFF).
+ *  - El EXE valida la respuesta `6C <bloque>` (RX[eco+3]==0x6C y RX[eco+4]==bloque) y aborta si no coincide.
+ *  - Las posiciones/tamaños coinciden con los offsets de la tabla de parámetros del EXE (offset - 10 = posición).
+ *
+ * Este objeto es PURO: construye y valida bytes. No envía nada y no está conectado a ninguna pantalla.
+ * `21 F0`/`21 F1` solo deben pedirse cuando [Session.canRead] sea verdadero para ese bloque.
+ */
+internal object DynamicBlockDefinitions {
+    /** MR-140: [pos, tam, identificadorComún]. ZF: [pos, tam, localId, offsetEnElLocalId]. */
+    data class Entry(val pos: Int, val size: Int, val source: Int, val offsetInSource: Int? = null)
+
+    enum class Mode { COMMON_ID, LOCAL_ID }
+
+    enum class Block(
+        val label: String,
+        val targetAddress: Int,
+        val blockId: Int,
+        val mode: Mode,
+        val entries: List<Entry>
+    ) {
+        MR140_F0("MR-140 F0", 0x11, 0xF0, Mode.COMMON_ID, listOf(
+        Entry(0x01, 1, 0x000B),
+        Entry(0x02, 1, 0x000D),
+        Entry(0x03, 1, 0x000E),
+        Entry(0x04, 1, 0x000F),
+        Entry(0x05, 1, 0x0011),
+        Entry(0x06, 2, 0x11AC),
+        Entry(0x08, 1, 0x0004),
+        Entry(0x09, 1, 0x1192),
+        Entry(0x0A, 2, 0x000C),
+        Entry(0x0C, 2, 0x12E3),
+        Entry(0x0E, 1, 0x1141),
+        Entry(0x0F, 1, 0x1143),
+        Entry(0x10, 1, 0x1145),
+        Entry(0x11, 1, 0x1146),
+        Entry(0x12, 1, 0x0007),
+        Entry(0x13, 1, 0x114E),
+        Entry(0x14, 1, 0x1155),
+        Entry(0x15, 1, 0x1101),
+        Entry(0x16, 1, 0x1170),
+        Entry(0x17, 1, 0x114B),
+        Entry(0x18, 1, 0x1172),
+        Entry(0x19, 1, 0x1190),
+        Entry(0x1A, 1, 0x0005),
+        Entry(0x1B, 1, 0x0006),
+        Entry(0x1C, 1, 0x119D),
+        Entry(0x1D, 1, 0x119E)
+        )),
+        MR140_F1("MR-140 F1", 0x11, 0xF1, Mode.COMMON_ID, listOf(
+        Entry(0x01, 1, 0x115E),
+        Entry(0x02, 2, 0x11A1),
+        Entry(0x04, 1, 0x11A6),
+        Entry(0x05, 2, 0x1193),
+        Entry(0x07, 1, 0x1176),
+        Entry(0x08, 1, 0x1100),
+        Entry(0x09, 1, 0x1104),
+        Entry(0x0A, 1, 0x1102),
+        Entry(0x0B, 1, 0x1103),
+        Entry(0x0C, 1, 0x11A0),
+        Entry(0x0D, 1, 0x1616),
+        Entry(0x0E, 1, 0x116F),
+        Entry(0x0F, 1, 0x12E2),
+        Entry(0x10, 1, 0x1144),
+        Entry(0x11, 1, 0x1200),
+        Entry(0x12, 2, 0x1201),
+        Entry(0x14, 2, 0x1202),
+        Entry(0x16, 2, 0x1203),
+        Entry(0x18, 2, 0x1204),
+        Entry(0x1A, 1, 0x11A3),
+        Entry(0x1B, 1, 0x12ED),
+        Entry(0x1C, 2, 0x121A),
+        Entry(0x1E, 1, 0x119B),
+        Entry(0x1F, 2, 0x11BB),
+        Entry(0x21, 1, 0x1171),
+        Entry(0x22, 2, 0x11C1),
+        Entry(0x24, 1, 0x11BD),
+        Entry(0x25, 1, 0x12F0)
+        )),
+        ZF_F0("ZF 4HP16 F0", 0x18, 0xF0, Mode.LOCAL_ID, listOf(
+        Entry(0x01, 1, 0x01, 1),
+        Entry(0x02, 1, 0x01, 2),
+        Entry(0x03, 1, 0x01, 3),
+        Entry(0x04, 1, 0x02, 1),
+        Entry(0x05, 2, 0x02, 2),
+        Entry(0x07, 1, 0x02, 4),
+        Entry(0x08, 2, 0x03, 1),
+        Entry(0x0A, 2, 0x03, 3),
+        Entry(0x0C, 2, 0x03, 5),
+        Entry(0x0E, 2, 0x03, 7),
+        Entry(0x10, 1, 0x03, 9),
+        Entry(0x11, 1, 0x03, 10),
+        Entry(0x12, 2, 0x03, 11),
+        Entry(0x14, 1, 0x03, 13),
+        Entry(0x15, 1, 0x03, 14),
+        Entry(0x16, 1, 0x04, 1),
+        Entry(0x17, 2, 0x04, 2),
+        Entry(0x19, 2, 0x04, 4),
+        Entry(0x1B, 2, 0x04, 6),
+        Entry(0x1D, 2, 0x04, 8),
+        Entry(0x1F, 2, 0x04, 10),
+        Entry(0x21, 2, 0x04, 12),
+        Entry(0x23, 2, 0x04, 14),
+        Entry(0x25, 2, 0x04, 16),
+        Entry(0x27, 1, 0x06, 1),
+        Entry(0x28, 1, 0x06, 3),
+        Entry(0x29, 1, 0x06, 4)
+        ));
+
+        /** Bytes de datos que devolverá `21 <bloque>` tras `61 <bloque>`. */
+        val dataBytes: Int get() = entries.last().pos + entries.last().size - 1
+        /** Byte de formato esperado en la respuesta `21 <bloque>` (0x80 | longitud). */
+        val readResponseFormatByte: Int get() = 0x80 or (2 + dataBytes)
+        /** Longitud total de la respuesta `21 <bloque>` con cabecera y checksum. */
+        val readResponseFrameLength: Int get() = dataBytes + 6
+        /** Bytes que el EXE pide a ReadFile para `21 <bloque>` (eco de 6 + respuesta). */
+        val exeReadCount: Int get() = dataBytes + 12
+    }
+
+    /** Prefijo de payload de la respuesta positiva a 0x2C: SID 0x6C + identificador del bloque. */
+    fun expectedPayloadPrefix(block: Block): ByteArray = byteArrayOf(0x6C, block.blockId.toByte())
+
+    fun buildDefinitionRequest(block: Block): ByteArray {
+        val body = ByteArrayOutputStream()
+        body.write(0x2C)
+        body.write(block.blockId)
+        for (e in block.entries) {
+            when (block.mode) {
+                Mode.COMMON_ID -> {
+                    body.write(0x02); body.write(e.pos); body.write(e.size)
+                    body.write((e.source shr 8) and 0xFF); body.write(e.source and 0xFF); body.write(0x01)
+                }
+                Mode.LOCAL_ID -> {
+                    body.write(0x01); body.write(e.pos); body.write(e.size)
+                    body.write(e.source and 0xFF); body.write(e.offsetInSource ?: error("ZF entry needs offset"))
+                }
+            }
+        }
+        val payload = body.toByteArray()
+        require(payload.size <= 0xFF) { "Definition body does not fit the one-byte length field" }
+        val frame = ByteArray(4 + payload.size + 1)
+        frame[0] = 0x80.toByte()
+        frame[1] = block.targetAddress.toByte()
+        frame[2] = 0xF1.toByte()
+        frame[3] = payload.size.toByte()
+        payload.copyInto(frame, destinationOffset = 4)
+        frame[frame.lastIndex] = checksum(frame.copyOfRange(0, frame.lastIndex)).toByte()
+        return frame
+    }
+
+    /** True solo si el checksum es válido y el payload empieza por `6C <bloque>`. */
+    fun isAcceptedResponse(frame: KwpProtocol.FrameCheck?, block: Block): Boolean {
+        if (frame == null || !frame.valid || frame.payload.size < 2) return false
+        return (frame.payload[0].toInt() and 0xFF) == 0x6C &&
+            (frame.payload[1].toInt() and 0xFF) == block.blockId
+    }
+
+    /** Motivo legible de rechazo; null si la respuesta es aceptable. */
+    fun rejectionReason(frame: KwpProtocol.FrameCheck?, block: Block): String? = when {
+        frame == null -> "sin respuesta"
+        !frame.valid -> "checksum inválido"
+        frame.payload.size >= 3 && (frame.payload[0].toInt() and 0xFF) == 0x7F &&
+            (frame.payload[1].toInt() and 0xFF) == 0x2C ->
+            "NRC 0x%02X a 0x2C".format(frame.payload[2].toInt() and 0xFF)
+        !isAcceptedResponse(frame, block) -> "respuesta distinta de 6C %02X".format(block.blockId)
+        else -> null
+    }
+
+    /**
+     * Compuerta de sesión: un bloque solo puede leerse con 0x21 después de que su definición haya sido
+     * aceptada en ESTA sesión. Debe reiniciarse con [reset] al desconectar o reiniciar la comunicación.
+     */
+    class Session {
+        private val accepted = mutableSetOf<Block>()
+        fun markAccepted(block: Block) { accepted.add(block) }
+        fun canRead(block: Block): Boolean = block in accepted
+        fun reset() = accepted.clear()
+    }
+
+    private fun checksum(bytes: ByteArray): Int = bytes.sumOf { it.toInt() and 0xFF } and 0xFF
+}
