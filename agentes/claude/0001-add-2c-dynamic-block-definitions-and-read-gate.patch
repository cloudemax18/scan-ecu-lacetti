+package com.cheviexplorer.android
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Pruebas unitarias ESTÁTICAS: comparan bytes contra la reconstrucción del EXE
+ * (opera/claud/tools/verify_kwp_sequences.py reproduce la misma comprobación contra el .exe).
+ * No sustituyen a una prueba en vehículo.
+ */
+class DynamicBlockDefinitionsTest {
+    private val mr140F0 = hex("80 11 F1 9E 2C F0 02 01 01 00 0B 01 02 02 01 00 0D 01 02 03 01 00 0E 01 02 04 01 00 0F 01 02 05 01 00 11 01 02 06 02 11 AC 01 02 08 01 00 04 01 02 09 01 11 92 01 02 0A 02 00 0C 01 02 0C 02 12 E3 01 02 0E 01 11 41 01 02 0F 01 11 43 01 02 10 01 11 45 01 02 11 01 11 46 01 02 12 01 00 07 01 02 13 01 11 4E 01 02 14 01 11 55 01 02 15 01 11 01 01 02 16 01 11 70 01 02 17 01 11 4B 01 02 18 01 11 72 01 02 19 01 11 90 01 02 1A 01 00 05 01 02 1B 01 00 06 01 02 1C 01 11 9D 01 02 1D 01 11 9E 01 80")
+    private val mr140F1 = hex("80 11 F1 AA 2C F1 02 01 01 11 5E 01 02 02 02 11 A1 01 02 04 01 11 A6 01 02 05 02 11 93 01 02 07 01 11 76 01 02 08 01 11 00 01 02 09 01 11 04 01 02 0A 01 11 02 01 02 0B 01 11 03 01 02 0C 01 11 A0 01 02 0D 01 16 16 01 02 0E 01 11 6F 01 02 0F 01 12 E2 01 02 10 01 11 44 01 02 11 01 12 00 01 02 12 02 12 01 01 02 14 02 12 02 01 02 16 02 12 03 01 02 18 02 12 04 01 02 1A 01 11 A3 01 02 1B 01 12 ED 01 02 1C 02 12 1A 01 02 1E 01 11 9B 01 02 1F 02 11 BB 01 02 21 01 11 71 01 02 22 02 11 C1 01 02 24 01 11 BD 01 02 25 01 12 F0 01 95")
+    private val zfF0 = hex("80 18 F1 89 2C F0 01 01 01 01 01 01 02 01 01 02 01 03 01 01 03 01 04 01 02 01 01 05 02 02 02 01 07 01 02 04 01 08 02 03 01 01 0A 02 03 03 01 0C 02 03 05 01 0E 02 03 07 01 10 01 03 09 01 11 01 03 0A 01 12 02 03 0B 01 14 01 03 0D 01 15 01 03 0E 01 16 01 04 01 01 17 02 04 02 01 19 02 04 04 01 1B 02 04 06 01 1D 02 04 08 01 1F 02 04 0A 01 21 02 04 0C 01 23 02 04 0E 01 25 02 04 10 01 27 01 06 01 01 28 01 06 03 01 29 01 06 04 8F")
+
+    @Test
+    fun buildsExactBytesReconstructedFromExe() {
+        assertArrayEquals(mr140F0, DynamicBlockDefinitions.buildDefinitionRequest(DynamicBlockDefinitions.Block.MR140_F0))
+        assertArrayEquals(mr140F1, DynamicBlockDefinitions.buildDefinitionRequest(DynamicBlockDefinitions.Block.MR140_F1))
+        assertArrayEquals(zfF0, DynamicBlockDefinitions.buildDefinitionRequest(DynamicBlockDefinitions.Block.ZF_F0))
+    }
+
+    @Test
+    fun framesHaveExpectedLengthsHeadersAndChecksums() {
+        data class Expect(val frame: ByteArray, val total: Int, val lenField: Int, val target: Int, val block: Int, val checksum: Int)
+        listOf(
+            Expect(mr140F0, 163, 0x9E, 0x11, 0xF0, 0x80),
+            Expect(mr140F1, 175, 0xAA, 0x11, 0xF1, 0x95),
+            Expect(zfF0, 142, 0x89, 0x18, 0xF0, 0x8F)
+        ).forEach { e ->
+            assertEquals(e.total, e.frame.size)
+            assertEquals(0x80, e.frame[0].toInt() and 0xFF)
+            assertEquals(e.target, e.frame[1].toInt() and 0xFF)
+            assertEquals(0xF1, e.frame[2].toInt() and 0xFF)
+            assertEquals(e.lenField, e.frame[3].toInt() and 0xFF)
+            assertEquals(4 + e.lenField + 1, e.frame.size)
+            assertEquals(0x2C, e.frame[4].toInt() and 0xFF)
+            assertEquals(e.block, e.frame[5].toInt() and 0xFF)
+            assertEquals(e.checksum, e.frame.last().toInt() and 0xFF)
+            assertEquals(e.checksum, e.frame.copyOfRange(0, e.frame.lastIndex).sumOf { it.toInt() and 0xFF } and 0xFF)
+        }
+    }
+
+    @Test
+    fun entriesAreContiguousAndTotalsMatchExpectedReadResponses() {
+        for (block in DynamicBlockDefinitions.Block.values()) {
+            var next = 1
+            for (e in block.entries) {
+                assertEquals("${block.label} hueco en pos $next", next, e.pos)
+                next += e.size
+            }
+        }
+        assertEquals(29, DynamicBlockDefinitions.Block.MR140_F0.dataBytes)
+        assertEquals(37, DynamicBlockDefinitions.Block.MR140_F1.dataBytes)
+        assertEquals(41, DynamicBlockDefinitions.Block.ZF_F0.dataBytes)
+        assertEquals(0x9F, DynamicBlockDefinitions.Block.MR140_F0.readResponseFormatByte)
+        assertEquals(0xA7, DynamicBlockDefinitions.Block.MR140_F1.readResponseFormatByte)
+        assertEquals(0xAB, DynamicBlockDefinitions.Block.ZF_F0.readResponseFormatByte)
+        assertEquals(35, DynamicBlockDefinitions.Block.MR140_F0.readResponseFrameLength)
+        assertEquals(43, DynamicBlockDefinitions.Block.MR140_F1.readResponseFrameLength)
+        // read counts que usa el EXE para 21 F0 / 21 F1 (MR-140) y 21 F0 (ZF)
+        assertEquals(41, DynamicBlockDefinitions.Block.MR140_F0.exeReadCount)
+        assertEquals(49, DynamicBlockDefinitions.Block.MR140_F1.exeReadCount)
+        assertEquals(53, DynamicBlockDefinitions.Block.ZF_F0.exeReadCount)
+    }
+
+    @Test
+    fun androidMr140TableCoversExactlyTheBytesOfEachBlock() {
+        // Mr140Params.kt: 24 parámetros F0 (último byte usado = 29 = tamaño de F0) y
+        // 32 parámetros F1 (último byte usado = 33; los bytes 34..37 de F1 no tienen fila en la tabla del EXE).
+        assertEquals(24, Mr140.decodeGroup(0xF0, ByteArray(29)).size)
+        assertEquals(32, Mr140.decodeGroup(0xF1, ByteArray(37)).size)
+        assertEquals(32, Mr140.decodeGroup(0xF1, ByteArray(33)).size)
+        assertTrue(Mr140.decodeGroup(0xF0, ByteArray(28)).size < 24)
+        assertTrue(Mr140.decodeGroup(0xF1, ByteArray(32)).size < 32)
+    }
+
+    @Test
+    fun acceptsOnlyPositive6CResponseWithMatchingBlockAndValidChecksum() {
+        val block = DynamicBlockDefinitions.Block.MR140_F0
+        val ok = frame(valid = true, payload = hex("6C F0"))
+        assertTrue(DynamicBlockDefinitions.isAcceptedResponse(ok, block))
+        assertNull(DynamicBlockDefinitions.rejectionReason(ok, block))
+        assertFalse(DynamicBlockDefinitions.isAcceptedResponse(frame(true, hex("6C F1")), block))
+        assertFalse(DynamicBlockDefinitions.isAcceptedResponse(frame(false, hex("6C F0")), block))
+        assertFalse(DynamicBlockDefinitions.isAcceptedResponse(frame(true, hex("7E")), block))
+        assertFalse(DynamicBlockDefinitions.isAcceptedResponse(null, block))
+        assertEquals("NRC 0x31 a 0x2C", DynamicBlockDefinitions.rejectionReason(frame(true, hex("7F 2C 31")), block))
+        assertEquals("checksum inválido", DynamicBlockDefinitions.rejectionReason(frame(false, hex("6C F0")), block))
+        assertEquals("sin respuesta", DynamicBlockDefinitions.rejectionReason(null, block))
+        assertNotNull(DynamicBlockDefinitions.rejectionReason(frame(true, hex("7E")), block))
+    }
+
+    @Test
+    fun readGateStaysClosedUntilDefinitionAcceptedAndResetsOnDisconnect() {
+        val session = DynamicBlockDefinitions.Session()
+        assertFalse(session.canRead(DynamicBlockDefinitions.Block.MR140_F0))
+        session.markAccepted(DynamicBlockDefinitions.Block.MR140_F0)
+        assertTrue(session.canRead(DynamicBlockDefinitions.Block.MR140_F0))
+        assertFalse(session.canRead(DynamicBlockDefinitions.Block.MR140_F1))
+        assertFalse(session.canRead(DynamicBlockDefinitions.Block.ZF_F0))
+        session.reset()
+        assertFalse(session.canRead(DynamicBlockDefinitions.Block.MR140_F0))
+    }
+
+    private fun frame(valid: Boolean, payload: ByteArray) =
+        KwpProtocol.FrameCheck(valid, "test", ByteArray(0), payload)
+
+    private fun hex(value: String): ByteArray =
+        value.split(" ").map { it.toInt(16).toByte() }.toByteArray()
+}
